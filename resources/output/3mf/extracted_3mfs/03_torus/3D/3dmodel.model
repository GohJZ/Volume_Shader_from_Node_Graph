<?xml version='1.0' encoding='utf-8'?>
<model xmlns="http://schemas.microsoft.com/3dmanufacturing/core/2015/02" xmlns:i="http://schemas.3mf.io/3dmanufacturing/implicit/2023/12" xmlns:v="http://schemas.3mf.io/3dmanufacturing/volumetric/2022/01" unit="millimeter" xml:lang="en-US" requiredextensions="v i">
  <metadata name="Application">Volume Shader from Node Graph examples</metadata>
  <resources>
    <i:implicitfunction id="1" displayname="main">
      <i:in>
        <i:vector identifier="pos" displayname="pos" />
      </i:in>
      <i:decomposevector identifier="torus_components" displayname="torus_components">
        <i:in>
          <i:vectorref identifier="A" displayname="A" ref="inputs.pos" />
        </i:in>
        <i:out>
          <i:scalar identifier="x" displayname="x" />
          <i:scalar identifier="y" displayname="y" />
          <i:scalar identifier="z" displayname="z" />
        </i:out>
      </i:decomposevector>
      <i:constant identifier="torus_zero" displayname="torus_zero" value="0">
        <i:out>
          <i:scalar identifier="value" displayname="value" />
        </i:out>
      </i:constant>
      <i:composevector identifier="torus_radial_vector" displayname="torus_radial_vector">
        <i:in>
          <i:scalarref identifier="x" displayname="x" ref="torus_components.x" />
          <i:scalarref identifier="y" displayname="y" ref="torus_components.y" />
          <i:scalarref identifier="z" displayname="z" ref="torus_zero.value" />
        </i:in>
        <i:out>
          <i:vector identifier="result" displayname="result" />
        </i:out>
      </i:composevector>
      <i:length identifier="torus_radial_length" displayname="torus_radial_length">
        <i:in>
          <i:vectorref identifier="A" displayname="A" ref="torus_radial_vector.result" />
        </i:in>
        <i:out>
          <i:scalar identifier="result" displayname="result" />
        </i:out>
      </i:length>
      <i:constant identifier="torus_major_radius" displayname="torus_major_radius" value="22">
        <i:out>
          <i:scalar identifier="value" displayname="value" />
        </i:out>
      </i:constant>
      <i:subtraction identifier="torus_radial_distance" displayname="torus_radial_distance">
        <i:in>
          <i:scalarref identifier="A" displayname="A" ref="torus_radial_length.result" />
          <i:scalarref identifier="B" displayname="B" ref="torus_major_radius.value" />
        </i:in>
        <i:out>
          <i:scalar identifier="result" displayname="result" />
        </i:out>
      </i:subtraction>
      <i:composevector identifier="torus_tube_vector" displayname="torus_tube_vector">
        <i:in>
          <i:scalarref identifier="x" displayname="x" ref="torus_radial_distance.result" />
          <i:scalarref identifier="y" displayname="y" ref="torus_zero.value" />
          <i:scalarref identifier="z" displayname="z" ref="torus_components.z" />
        </i:in>
        <i:out>
          <i:vector identifier="result" displayname="result" />
        </i:out>
      </i:composevector>
      <i:length identifier="torus_tube_length" displayname="torus_tube_length">
        <i:in>
          <i:vectorref identifier="A" displayname="A" ref="torus_tube_vector.result" />
        </i:in>
        <i:out>
          <i:scalar identifier="result" displayname="result" />
        </i:out>
      </i:length>
      <i:constant identifier="torus_minor_radius" displayname="torus_minor_radius" value="7">
        <i:out>
          <i:scalar identifier="value" displayname="value" />
        </i:out>
      </i:constant>
      <i:subtraction identifier="torus_distance" displayname="torus_distance">
        <i:in>
          <i:scalarref identifier="A" displayname="A" ref="torus_tube_length.result" />
          <i:scalarref identifier="B" displayname="B" ref="torus_minor_radius.value" />
        </i:in>
        <i:out>
          <i:scalar identifier="result" displayname="result" />
        </i:out>
      </i:subtraction>
      <i:out>
        <i:scalarref identifier="shape" displayname="shape" ref="torus_distance.result" />
      </i:out>
    </i:implicitfunction>
    <object id="2" name="Evaluation domain" type="model">
      <mesh>
        <vertices>
          <vertex x="-34" y="-34" z="-14" />
          <vertex x="34" y="-34" z="-14" />
          <vertex x="34" y="34" z="-14" />
          <vertex x="-34" y="34" z="-14" />
          <vertex x="-34" y="-34" z="14" />
          <vertex x="34" y="-34" z="14" />
          <vertex x="34" y="34" z="14" />
          <vertex x="-34" y="34" z="14" />
        </vertices>
        <triangles>
          <triangle v1="0" v2="2" v3="1" />
          <triangle v1="0" v2="3" v3="2" />
          <triangle v1="4" v2="5" v3="6" />
          <triangle v1="4" v2="6" v3="7" />
          <triangle v1="0" v2="1" v3="5" />
          <triangle v1="0" v2="5" v3="4" />
          <triangle v1="2" v2="3" v3="7" />
          <triangle v1="2" v2="7" v3="6" />
          <triangle v1="1" v2="2" v3="6" />
          <triangle v1="1" v2="6" v3="5" />
          <triangle v1="0" v2="4" v3="7" />
          <triangle v1="0" v2="7" v3="3" />
        </triangles>
      </mesh>
    </object>
    <object id="3" name="Torus" type="model">
      <v:levelset functionid="1" meshid="2" channel="shape" meshbboxonly="true" />
    </object>
  </resources>
  <build>
    <item objectid="3" />
  </build>
</model>