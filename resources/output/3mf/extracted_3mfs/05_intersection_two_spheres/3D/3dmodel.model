<?xml version='1.0' encoding='utf-8'?>
<model xmlns="http://schemas.microsoft.com/3dmanufacturing/core/2015/02" xmlns:i="http://schemas.3mf.io/3dmanufacturing/implicit/2023/12" xmlns:v="http://schemas.3mf.io/3dmanufacturing/volumetric/2022/01" unit="millimeter" xml:lang="en-US" requiredextensions="v i">
  <metadata name="Application">Volume Shader from Node Graph examples</metadata>
  <resources>
    <i:implicitfunction id="1" displayname="main">
      <i:in>
        <i:vector identifier="pos" displayname="pos" />
      </i:in>
      <i:constvec identifier="left_center" displayname="left_center" x="-10" y="0" z="0">
        <i:out>
          <i:vector identifier="vector" displayname="vector" />
        </i:out>
      </i:constvec>
      <i:subtraction identifier="left_local" displayname="left_local">
        <i:in>
          <i:vectorref identifier="A" displayname="A" ref="inputs.pos" />
          <i:vectorref identifier="B" displayname="B" ref="left_center.vector" />
        </i:in>
        <i:out>
          <i:vector identifier="result" displayname="result" />
        </i:out>
      </i:subtraction>
      <i:length identifier="left_length" displayname="left_length">
        <i:in>
          <i:vectorref identifier="A" displayname="A" ref="left_local.result" />
        </i:in>
        <i:out>
          <i:scalar identifier="result" displayname="result" />
        </i:out>
      </i:length>
      <i:constant identifier="left_radius" displayname="left_radius" value="18">
        <i:out>
          <i:scalar identifier="value" displayname="value" />
        </i:out>
      </i:constant>
      <i:subtraction identifier="left_distance" displayname="left_distance">
        <i:in>
          <i:scalarref identifier="A" displayname="A" ref="left_length.result" />
          <i:scalarref identifier="B" displayname="B" ref="left_radius.value" />
        </i:in>
        <i:out>
          <i:scalar identifier="result" displayname="result" />
        </i:out>
      </i:subtraction>
      <i:constvec identifier="right_center" displayname="right_center" x="10" y="0" z="0">
        <i:out>
          <i:vector identifier="vector" displayname="vector" />
        </i:out>
      </i:constvec>
      <i:subtraction identifier="right_local" displayname="right_local">
        <i:in>
          <i:vectorref identifier="A" displayname="A" ref="inputs.pos" />
          <i:vectorref identifier="B" displayname="B" ref="right_center.vector" />
        </i:in>
        <i:out>
          <i:vector identifier="result" displayname="result" />
        </i:out>
      </i:subtraction>
      <i:length identifier="right_length" displayname="right_length">
        <i:in>
          <i:vectorref identifier="A" displayname="A" ref="right_local.result" />
        </i:in>
        <i:out>
          <i:scalar identifier="result" displayname="result" />
        </i:out>
      </i:length>
      <i:constant identifier="right_radius" displayname="right_radius" value="18">
        <i:out>
          <i:scalar identifier="value" displayname="value" />
        </i:out>
      </i:constant>
      <i:subtraction identifier="right_distance" displayname="right_distance">
        <i:in>
          <i:scalarref identifier="A" displayname="A" ref="right_length.result" />
          <i:scalarref identifier="B" displayname="B" ref="right_radius.value" />
        </i:in>
        <i:out>
          <i:scalar identifier="result" displayname="result" />
        </i:out>
      </i:subtraction>
      <i:max identifier="sphere_intersection" displayname="sphere_intersection">
        <i:in>
          <i:scalarref identifier="A" displayname="A" ref="left_distance.result" />
          <i:scalarref identifier="B" displayname="B" ref="right_distance.result" />
        </i:in>
        <i:out>
          <i:scalar identifier="result" displayname="result" />
        </i:out>
      </i:max>
      <i:out>
        <i:scalarref identifier="shape" displayname="shape" ref="sphere_intersection.result" />
      </i:out>
    </i:implicitfunction>
    <object id="2" name="Evaluation domain" type="model">
      <mesh>
        <vertices>
          <vertex x="-25" y="-25" z="-25" />
          <vertex x="25" y="-25" z="-25" />
          <vertex x="25" y="25" z="-25" />
          <vertex x="-25" y="25" z="-25" />
          <vertex x="-25" y="-25" z="25" />
          <vertex x="25" y="-25" z="25" />
          <vertex x="25" y="25" z="25" />
          <vertex x="-25" y="25" z="25" />
        </vertices>
        <triangles>
          <triangle v1="0" v2="2" v3="1" />
          <triangle v1="0" v2="3" v3="2" />
          <triangle v1="4" v2="5" v3="6" />
          <triangle v1="4" v2="6" v3="7" />
          <triangle v1="0" v2="1" v3="5" />
          <triangle v1="0" v2="5" v3="4" />
          <triangle v1="2" v2="3" v3="7" />
          <triangle v1="2" v2="7" v3="6" />
          <triangle v1="1" v2="2" v3="6" />
          <triangle v1="1" v2="6" v3="5" />
          <triangle v1="0" v2="4" v3="7" />
          <triangle v1="0" v2="7" v3="3" />
        </triangles>
      </mesh>
    </object>
    <object id="3" name="Intersection of two spheres" type="model">
      <v:levelset functionid="1" meshid="2" channel="shape" meshbboxonly="true" />
    </object>
  </resources>
  <build>
    <item objectid="3" />
  </build>
</model>